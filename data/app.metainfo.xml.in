<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Markdown Viewer</name>
  <summary>Browse, read and write Markdown files</summary>
  <description>
    <p>
      Open a folder and browse its Markdown files in the sidebar. Read them
      nicely laid out, or switch to the editor to change them. Your changes
      are saved as you type.
    </p>
    <ul>
      <li>Markdown is shown with native widgets, without a web engine</li>
      <li>Tables, task lists, block quotes and code with syntax highlighting</li>
      <li>Mermaid diagrams: flowcharts, sequence, class, state and entity relationship diagrams, and pie charts</li>
      <li>Edit and preview side by side</li>
      <li>Select and copy text across the whole note</li>
      <li>New notes stay drafts until you save them</li>
      <li>Adjustable text size</li>
      <li>Find files by name or content in the open folder</li>
      <li>Follows the system light and dark style</li>
    </ul>
  </description>

  <developer id="io.github.jefersondaniel">
    <name>Jeferson Souza</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <provides>
    <binary>gnome-markdown</binary>
  </provides>

  <url type="homepage">https://github.com/jefersondaniel/markdown-viewer</url>
  <url type="bugtracker">https://github.com/jefersondaniel/markdown-viewer/issues</url>
  <url type="vcs-browser">https://github.com/jefersondaniel/markdown-viewer</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jefersondaniel/markdown-viewer/main/data/screenshots/view.png</image>
      <caption>A note with a diagram in View mode, with the folder in the sidebar</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jefersondaniel/markdown-viewer/main/data/screenshots/side-by-side.png</image>
      <caption>Edit and preview side by side</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jefersondaniel/markdown-viewer/main/data/screenshots/dark.png</image>
      <caption>Dark style</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <releases>
    <release version="@VERSION@" date="@RELEASE_DATE@">
      <url type="details">https://github.com/jefersondaniel/markdown-viewer/releases/tag/v@VERSION@</url>
    </release>
  </releases>
</component>
