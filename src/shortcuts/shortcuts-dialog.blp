using Gtk 4.0;
using Adw 1;

// Used with libadwaita 1.8 and newer; shortcuts-window.blp covers older versions.
Adw.ShortcutsDialog shortcuts {
  Adw.ShortcutsSection {
    title: _("Files");

    Adw.ShortcutsItem {
      title: _("New Note");
      action-name: "win.new-note";
    }

    Adw.ShortcutsItem {
      title: _("Open Folder");
      action-name: "win.open-folder";
    }

    Adw.ShortcutsItem {
      title: _("Open File");
      action-name: "win.open";
    }

    Adw.ShortcutsItem {
      title: _("Save Now");
      action-name: "win.save";
    }

    Adw.ShortcutsItem {
      title: _("Previous File");
      action-name: "win.go-back";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Switch Between View and Edit");
      action-name: "win.toggle-mode";
    }

    Adw.ShortcutsItem {
      title: _("Side by Side");
      action-name: "win.split";
    }

    Adw.ShortcutsItem {
      title: _("Find in Note");
      action-name: "win.find";
    }

    Adw.ShortcutsItem {
      title: _("Toggle Sidebar");
      action-name: "win.toggle-sidebar";
    }

    Adw.ShortcutsItem {
      title: _("Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: _("Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: _("Reset Zoom");
      action-name: "win.zoom-reset";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editing");

    Adw.ShortcutsItem {
      title: _("Bold");
      accelerator: "<Control>b";
    }

    Adw.ShortcutsItem {
      title: _("Italic");
      accelerator: "<Control>i";
    }

    Adw.ShortcutsItem {
      title: _("Link");
      accelerator: "<Control>k";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "win.keyboard-shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
